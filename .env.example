# Copia este archivo como ".env" para trabajar en tu PC.
# En Render NO se sube el .env: esas mismas variables se escriben en el panel (Environment).
PORT=3000

# ---------- Base de datos ----------
# (A) En tu PC con XAMPP:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=roles_app

# (B) En la nube con Always Data (usa estos valores en lugar de los de arriba):
#   DB_HOST=mysql-TUCUENTA.alwaysdata.net
#   DB_PORT=3306
#   DB_USER=TUCUENTA            (o el usuario que crees en el panel, ej. TUCUENTA_app)
#   DB_PASSWORD=la_contraseña_de_ese_usuario
#   DB_NAME=TUCUENTA_roles      (el nombre COMPLETO con prefijo que muestra el panel)

# Solo si tu proveedor exige conexión segura (Always Data normalmente no lo exige):
# DB_SSL=true

# true = al arrancar, el servidor crea las tablas y datos de ejemplo si faltan.
# Ponlo en true en Render (el plan gratuito no tiene terminal).
AUTO_SETUP=false

# ---------- Sesión ----------
# Cambia este texto por uno largo y secreto (firma los tokens de sesión).
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_unico
JWT_EXPIRES_IN=8h
